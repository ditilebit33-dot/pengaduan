rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Complaints collection
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    // Config collection
    match /config/{configId} {
      allow read, write: if true;
    }
  }
}

